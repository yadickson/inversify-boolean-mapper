{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "dots", "html"],
  "mutate": [ 
    "src/**/*.ts"
  ],
  "mochaOptions": {
    "config": ".mocharc.json"
  },
  "thresholds": { "high": 80, "low": 60, "break": 100 },
  "concurrency": 1,
  "allowConsoleColors": true,
  "clearTextReporter": {
    "allowColor": true
  }
}
